# URL do backend Express (mesmo processo que serve o storefront antigo hoje).
# Usado tanto pelo proxy (next.config.ts rewrites) quanto pelos Server Components
# que buscam dados direto no backend (sem passar pelo proxy).
API_ORIGIN=http://localhost:9090

# Mesma origem do backend, só que em protocolo ws:// (wss:// em produção) e
# NEXT_PUBLIC_ pra existir no navegador — a conexão de WebSocket (status de
# pagamento em tempo real) não passa pelo proxy /api/* do Next (rewrites não
# garantem upgrade de protocolo nesta versão), então o navegador abre direto
# nessa origem. Não carrega cookie de sessão (cross-origin de verdade); a
# autenticação da conexão é feita por um ticket avulso, obtido antes via
# GET /order/realtime-ticket (esse sim passa pelo proxy).
NEXT_PUBLIC_WS_ORIGIN=ws://localhost:9090
